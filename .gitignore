# LƯU Ý: pnpm-lock.yaml PHẢI được commit.
# Script khởi động chạy `pnpm install --frozen-lockfile` — lệnh này lỗi cứng
# nếu thiếu lockfile, và thiếu nó thì máy user cài ra version khác máy dev.
